# ============================================================================
# Central project configuration
# Docker Compose reads this file automatically.
# Airflow/Spark/HDFS/ClickHouse containers also load it through `env_file: .env`.
# ============================================================================
# Runtime mode
USE_LOCAL=false

# Hadoop / HDFS
HDFS_NAMENODE=namenode:9000
WEBHDFS_HOST=namenode:9870
HADOOP_USER_NAME=root
HDFS_USER=root

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=24G
SPARK_WORKER_CORES=6

# Airflow
AIRFLOW_SECRET_KEY=distributed-nlp-airflow-shared-secret

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=tech_radar
CLICKHOUSE_USER=root
CLICKHOUSE_PASSWORD=root
CLICKHOUSE_PASS=root
CLICKHOUSE_TABLE=stg_keyword_freq

# Processing paths
RAW_LOCAL_PATH=/opt/airflow/crawlers/data
STAGED_LOCAL_PATH=/opt/airflow/data/preprocessed/stg_posts_core
LDA_LOCAL_OUTPUT=/opt/airflow/output/lda
LOCAL_SENTIMENT_MODEL_PATH=/opt/airflow/models/phobert_finetuned/final
LOCAL_STOPWORDS_PATH=/opt/airflow/data/stopwords_vi.txt
LOCAL_SLANG_DICT_PATH=/opt/airflow/data/slang_dict.json

# Crisis / retrain shared paths
HDFS_MODEL_DIR=hdfs://namenode:9000/user/root/models/crisis_detection
HDFS_STG_POSTS_CORE=hdfs://namenode:9000/user/root/staged/stg_posts_core
MODEL_LOCAL_DIR=/tmp/airflow_models
IF_MODEL_PATH=/opt/airflow/models/isolation_forest_hourly.pkl
CLF_MODEL_PATH=/opt/airflow/models/crisis_classifier.pkl
